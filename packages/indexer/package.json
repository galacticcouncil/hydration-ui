{
  "name": "@galacticcouncil/indexer",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc --build",
    "lint": "yarn lint:eslint && yarn lint:ts",
    "lint:ts": "tsc --noEmit -p tsconfig.json",
    "lint:eslint": "eslint src",
    "lint:fix": "eslint src --fix",
    "codegen:indexer": "graphql-codegen --config src/indexer/codegen.ts",
    "codegen:squid": "graphql-codegen --config src/squid/codegen.ts",
    "codegen:multix": "graphql-codegen --config src/multix/codegen.ts",
    "schema:api": "curl -sSL https://hydration-api.neckwork.net/docs/json -o src/neckwork/openapi.json && node -e \"const fs=require('fs'),f='src/neckwork/openapi.json';fs.writeFileSync(f,JSON.stringify(JSON.parse(fs.readFileSync(f,'utf8')),null,2)+'\\n')\"",
    "codegen:api": "openapi-typescript src/neckwork/openapi.json --alphabetize --immutable -o src/neckwork/__generated__/schema.ts"
  },
  "exports": {
    "./indexer": "./src/indexer/index.ts",
    "./neckwork": "./src/neckwork/index.ts",
    "./squid": "./src/squid/index.ts",
    "./squid/lib/*": "./src/squid/lib/*.ts",
    "./multix": "./src/multix/index.ts"
  },
  "dependencies": {
    "graphql": "^16.11.0",
    "graphql-request": "^7.2.0",
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/import-types-preset": "^3.0.1",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "graphql-config": "^5.1.5",
    "openapi-typescript": "^7.13.0"
  }
}
